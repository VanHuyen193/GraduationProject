eom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" anchor="t"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="200"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr sz="1600" b="1" i="0"><a:solidFill><a:srgbClr val="32538F"/></a:solidFill><a:latin typeface="Calibri"/></a:rPr><a:t>③ Bốn thay đổi</a:t></a:r></a:p><a:p><a:pPr algn="l"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="800"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr sz="1400" b="1" i="1"><a:solidFill><a:srgbClr val="666E7E"/></a:solidFill><a:latin typeface="Calibri"/></a:rPr><a:t>chuyển từ phạt sang thưởng</a:t></a:r></a:p><a:p><a:pPr algn="l"><a:lnSpc><a:spcPct val="112000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="800"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr sz="1400" b="0" i="0"><a:solidFill><a:srgbClr val="2B2B2B"/></a:solidFill><a:latin typeface="Calibri"/></a:rPr><a:t>Gỡ toàn bộ phạt nhóm, thay bằng thưởng bàn giao một lần. Chuyển tín hiệu dẫn đường sang định hình theo thế năng. Thêm ân hạn một giây. Bổ sung hai cờ vượt cổng vào quan sát.</a:t></a:r></a:p><a:p><a:pPr algn="l"><a:lnSpc><a:spcPct val="110000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr sz="1350" b="1" i="0"><a:solidFill><a:srgbClr val="32538F"/></a:solidFill><a:latin typeface="Calibri"/></a:rPr><a:t>Phần thưởng nhóm thoát mức sàn, leo tới giá trị của một lời giải trọn vẹn.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="12" name="Rounded Rectangle 11"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="502920" y="5212080"/><a:ext cx="11201400" cy="868680"/></a:xfrm><a:prstGeom prst="roundRect"><a:avLst><a:gd name="adj" fmla="val 10000"/></a:avLst></a:prstGeom><a:solidFill><a:srgbClr val="FFFFFF"/></a:solidFill><a:ln w="12700"><a:solidFill><a:srgbClr val="F26522"/></a:solidFill></a:ln><a:effectLst/></p:spPr><p:style><a:lnRef idx="1"><a:schemeClr val="accent1"/></a:lnRef><a:fillRef idx="3"><a:schemeClr val="accent1"/></a:fillRef><a:effectRef idx="2"><a:schemeClr val="accent1"/></a:effectRef><a:fontRef idx="minor"><a:schemeClr val="lt1"/></a:fontRef></p:style><p:txBody><a:bodyPr wrap="square" lIns="128016" tIns="73152" rIns="128016" bIns="73152" rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr algn="ctr"/><a:endParaRPr/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="13" name="TextBox 12"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="777240" y="5358384"/><a:ext cx="10652760" cy="658368"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" anchor="t"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="ctr"><a:lnSpc><a:spcPct val="110000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr sz="1450" b="0" i="0"><a:solidFill><a:srgbClr val="2B2B2B"/></a:solidFill><a:latin typeface="Calibri"/></a:rPr><a:t>Bài học dùng lại được: một hàm phần thưởng hỏng thường để lại dấu vết định lượng rất rõ ngay trên chỉ số huấn luyện — chẳng hạn mắc kẹt đúng ở giá trị của một thành phần phạt. Biết đọc dấu vết ấy là công cụ chẩn đoán hiệu quả hơn hẳn việc dò hệ số một cách mù quáng.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>